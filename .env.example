# Copy to .env.local for local development. Values for local Supabase come from `npx supabase status`.

# Public (browser-safe; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret (bypasses RLS) — never expose, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Used to build invitation links
APP_ORIGIN=http://localhost:3000
INVITE_TTL_HOURS=72

# Optional AI (M3). Leave AI_PROVIDER empty to disable AI features.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_BATCH_SIZE=20
